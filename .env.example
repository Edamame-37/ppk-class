# Konfigurasi Firebase Project (Salin file ini menjadi .env dan isi dengan kredensial Firebase Console Anda)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Web Client ID wajib untuk login Google native (gunakan proyek Firebase yang sama)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Isi hanya jika membangun iOS; URL scheme akan dibuat otomatis dari Client ID ini
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Harus cocok dengan aplikasi Android/iOS yang didaftarkan di Firebase/Google Cloud
ANDROID_PACKAGE=com.ppkclass.app
IOS_BUNDLE_IDENTIFIER=com.ppkclass.app

